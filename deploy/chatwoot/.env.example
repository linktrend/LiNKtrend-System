# Chatwoot production env for linkdroplet-00.
# Copy to /opt/linktrend/chatwoot/.env on the VPS. Do not commit real values.

FRONTEND_URL=https://chatwoot.linktrend.internal
SECRET_KEY_BASE=replace_with_lengthy_secure_hex
ENABLE_ACCOUNT_SIGNUP=false
# Keep false so LiNKaios can call http://chatwoot-rails-1:3000 on the Docker network.
FORCE_SSL=false

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DATABASE=chatwoot
RAILS_ENV=production
RAILS_MAX_THREADS=5

REDIS_URL=redis://:replace_with_redis_password@redis:6379
REDIS_PASSWORD=replace_with_redis_password

MAILER_SENDER_EMAIL=Chatwoot <support@linktrend.media>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# LiNKaios sync (also stored in GSM for linkaios runtime)
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_API_ACCESS_TOKEN=replace_with_user_api_token
