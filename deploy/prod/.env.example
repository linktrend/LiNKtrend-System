# LiNKaios production deploy pointers. Commit secret names only; runtime values
# are rendered into /opt/linktrend/runtime/linkaios/prod.env.runtime on the VPS.
# Copy to deploy/prod/.env on the host and fill build-time public values.

# Build-time public values for Next.js image build
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Runtime host / app
NODE_ENV=production
PORT=3000
# LINKAIOS_UI_MOCKS — not used in production (hard-disabled when NODE_ENV=production).
LINKAIOS_ENABLE_DEV_AUTH_BYPASS=0
LINKAIOS_ENABLE_MVO_SERVICE_BYPASS=1
LINKAIOS_DISABLE_MVO_USER_KERNEL_API=0
LINKSITES_REGISTRY_PATH=/srv/linktrend/LiNKsites/apps/web-master
LINKSITES_TEMPLATE_DISCOVERY_MODE=dynamic
ZULIP_GATEWAY_PORT=8790
COMMAND_CENTRE_BOOTSTRAP_ADMIN_EMAILS=product@linktrend.media

# Traefik routing
TRAEFIK_ROUTER_NAME=linkaios
TRAEFIK_HOST=linkaios.linktrend.internal
TRAEFIK_ENTRYPOINTS=websecure
# TLS: Traefik default cert from internal CA (*.linktrend.internal). Do not use letsencrypt here.

# GSM / host mount (service account JSON on VPS)
GCP_PROJECT_ID=linkbot-901208
GOOGLE_APPLICATION_CREDENTIALS=/etc/linktrend/gcp/linkbot-901208-e7677c682cff.json
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/etc/linktrend/gcp/linkbot-901208-e7677c682cff.json

# Non-secret runtime config
CRM_PROVIDER=chatwoot
CRM_MODE=shadow_readiness
# Rails listens on plain HTTP inside Docker; FORCE_SSL=false on Chatwoot deploy.
CHATWOOT_BASE_URL=http://chatwoot-rails-1:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_SUPPORT_SYNC_MODE=live
CHATWOOT_READINESS_TIMEOUT_MS=5000
ACCOUNTING_PROVIDER=stub
ACCOUNTING_MODE=mock_read
PREVIEW_PUBLISH_MODE=static
PREVIEW_PUBLISH_DIGITALOCEAN_ENABLED=0
ZULIP_RUN_MESSAGING_MODE=live
# LiNKaios web (Work → Messages "Open in Zulip" links)
ZULIP_SITE_URL=https://zulip.linktrend.internal
ZULIP_INTERNAL_HOST_IP=100.86.158.30
ZULIP_TLS_INSECURE=1
ZULIP_RUN_STREAM=linktrend-runs
ZULIP_RUN_TOPIC_TEMPLATE=run:{run_id}
POSTIZ_DISTRIBUTION_MODE=mock

# Plane (studio-provided — live execution tracking for MVO staging)
LINKSKILLS_PLANE_MODE=live
PLANE_API_BASE_URL=https://plane.linktrend.internal
PLANE_WORKSPACE_SLUG=linkprojects
NEXT_PUBLIC_PLANE_URL=https://plane.linktrend.internal
NEXT_PUBLIC_PLANE_WORKSPACE_SLUG=linkprojects
MVO_TENANT_SLUG=calusa
# Licensor tenant for Admin LinkSkills leases/governance + vendor project launch.
# Slug linktrend (LiNKtrend studio vendor scope) — not demo licensee calusa.
LICENSOR_TENANT_ID=da570876-176d-452a-a428-6536d48303e9

# GSM-backed secrets (names must exist in GCP project)
DATABASE_URL_SECRET_NAME=LINKTREND_ADMINDB_SUPABASE_SESSION_POOLER_URL
SUPABASE_SECRET_KEY_SECRET_NAME=LINKTREND_AIOS_PROD_SUPABASE_SERVICE_ROLE
BOT_KERNEL_API_SECRET_SECRET_NAME=LINKTREND_AIOS_PROD_AIOS_INGRESS_TOKEN
PLANE_API_KEY_SECRET_NAME=LINKTREND_AIOS_PROD_PLANE_API_KEY
# Rendered at deploy time as PLANE_API_KEY (not PLANE_API_KEY_SECRET_NAME)
ZULIP_BOT_EMAIL_SECRET_NAME=LINKTREND_AIOS_PROD_ZULIP_BOT_EMAIL
ZULIP_BOT_API_KEY_SECRET_NAME=LINKTREND_AIOS_PROD_ZULIP_BOT_API_KEY
CHATWOOT_API_ACCESS_TOKEN_SECRET_NAME=LINKTREND_AIOS_PROD_CHATWOOT_API_ACCESS_TOKEN
OPENCLAW_RUN_AUTH_BEARER_SECRET_NAME=LINKTREND_AIOS_PROD_AIOS_INGRESS_TOKEN
# In-container URL on linktrend-network (not localhost). Traefik hostname also works for host-side probes.
OPENCLAW_AGENT_RUN_URL=http://openclaw-gateway:18789/v1/linktrend/agent-run
OPENCLAW_AGENT_RUN_BODY=agent_params

# LiNKautowork live (Area 4) — handler mode in linkaios; n8n optional via AUTOWORK_MODE on gateway sidecar
LINKAUTOWORK_DISPATCH_MODE=live
LINKAUTOWORK_MVO_MODE=live
AUTOWORK_MODE=handler
LINKAUTOWORK_PAYLOAD_BASE_URL=https://cms.linktrend.internal
# Rendered at deploy time as LINKAUTOWORK_PAYLOAD_API_KEY (GSM: LINKTREND_LINKSITES_PROD_PAYLOAD_API_KEY)
LINKAUTOWORK_PAYLOAD_API_KEY_SECRET_NAME=LINKTREND_LINKSITES_PROD_PAYLOAD_API_KEY
LINKAUTOWORK_INVOKE_SECRET_SECRET_NAME=LINKTREND_AIOS_PROD_AUTOWORK_INVOKE_TOKEN
LINKAUTOWORK_ARTIFACT_ROOT=/var/linktrend/linksites-artifacts
N8N_BASE_URL=https://n8n.linktrend.internal
N8N_API_KEY_SECRET_NAME=LINKAUTOWORK_N8N_API_KEY_PROD

# MVO live proof artifacts (mounted at /app/mvo-artifacts in linkaios container)
MVO_ARTIFACTS_HOST_DIR=/opt/linktrend/linkaios/LiNKdev/product/reports/linktrend-system
MVO_LIVE_RUN=1
MVO_LIVE_PUBLISH_PATH=/app/mvo-artifacts/mvo-live-publish.json
MVO_LATEST_RUN_PATH=/app/mvo-artifacts/mvo-latest-run.json
