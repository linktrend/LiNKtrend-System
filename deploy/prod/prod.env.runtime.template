# --- Zulip (Work → Messages deep links + zulip-gateway outbound) ---
# Site URL: Tailscale/internal DNS on linkdroplet-01 collaboration node.
ZULIP_SITE_URL=https://zulip.linktrend.internal
# Tailscale IP for zulip.linktrend.internal — used by docker-compose.deploy.yml extra_hosts.
ZULIP_INTERNAL_HOST_IP=100.86.158.30
# Internal CA cert — browsers need linktrend-internal-ca.crt trusted; gateway may skip verify.
ZULIP_TLS_INSECURE=1
ZULIP_GATEWAY_PORT=8790
ZULIP_RUN_MESSAGING_MODE=live
ZULIP_RUN_STREAM=linktrend-runs
ZULIP_RUN_TOPIC_TEMPLATE=run:{run_id}
