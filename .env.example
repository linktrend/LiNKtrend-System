# Copy to .env and fill in locally. Never commit .env to git.
# After any credential was shared in chat, rotate keys in Supabase Dashboard.

# LiNKaios: comma-separated emails treated as admin only when there is no linkaios.user_access row.
# If a user already has a row (e.g. role operator), set admin in the DB (migration 021) or via /settings/access.
COMMAND_CENTRE_BOOTSTRAP_ADMIN_EMAILS=

# LiNKaios web: set to 1 for synthetic sidebar/projects/work fixtures + banner (UX review on empty DB). Omit for production.
LINKAIOS_UI_MOCKS=

# Supabase (LiNKtrend-AdminDB)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Direct Postgres (migrations / tooling). Prefer Session pooler URI from Dashboard → Connect
# if db.<ref>.supabase.co fails with ENOTFOUND on IPv4-only networks.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# MVO kernel API service token (used by demo/E2E calls to /api/kernel/* endpoints)
BOT_KERNEL_API_SECRET=
# Set to true/1 only for MVO automation that uses BOT_KERNEL_API_SECRET.
LINKAIOS_ENABLE_MVO_SERVICE_BYPASS=
# Optional: comma-separated Supabase auth user IDs allowed to call kernel APIs.
LINKAIOS_MVO_KERNEL_OPERATOR_USER_IDS=
# Optional: set true/1 to require service bypass and reject user-token kernel API calls.
LINKAIOS_DISABLE_MVO_USER_KERNEL_API=

# Integration provider placeholders (defaults keep external integrations disabled)
CRM_PROVIDER=stub
CRM_MODE=stub_write
ODOO_BASE_URL=
ODOO_CREDENTIAL_REF=
ACCOUNTING_PROVIDER=stub
ACCOUNTING_MODE=mock_read
ACCOUNTING_MOCK_TABLE_REF=
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
# Chatwoot readiness GET timeout in ms (shadow_readiness mode only). Default 5000.
CHATWOOT_READINESS_TIMEOUT_MS=5000
PLANE_API_BASE_URL=
PLANE_WORKSPACE_SLUG=
PLANE_API_KEY=
DIGITALOCEAN_ACCESS_TOKEN=
DIGITALOCEAN_PROJECT_ID=
DIGITALOCEAN_APP_ID=
DIGITALOCEAN_REGISTRY_NAME=
# Preview publish adapter mode (default static). Set digitalocean only when testing hosted scaffold.
PREVIEW_PUBLISH_MODE=static
# DigitalOcean hosted preview path is opt-in and disabled by default.
PREVIEW_PUBLISH_DIGITALOCEAN_ENABLED=0
# Hosted preview URL base when PREVIEW_PUBLISH_MODE=digitalocean.
DIGITALOCEAN_PREVIEW_BASE_URL=

# Zulip (self-hosted app uses its own Postgres; these are for our gateway only)
ZULIP_SITE_URL=
ZULIP_BOT_EMAIL=
ZULIP_BOT_API_KEY=
# Capability scaffold defaults: no live outbound send. Use shadow only for readiness probes.
ZULIP_RUN_MESSAGING_MODE=mock
ZULIP_RUN_STREAM=
ZULIP_RUN_TOPIC_TEMPLATE=run:{run_id}
# Postiz distribution scaffold defaults: draft/schedule mock only; no live publishing.
POSTIZ_DISTRIBUTION_MODE=mock
POSTIZ_WORKSPACE_REF=
POSTIZ_DRAFT_CHANNEL_SET=
ZULIP_GATEWAY_PORT=8790
PRISM_HEARTBEAT_MS=60000
PRISM_RESIDUE_SWEEP=
PRISM_RESIDUE_BATCH=25

# Local mock that accepts bot-runtime POST (default port 8789)
OPENCLAW_SHIM_PORT=8789

# OpenClaw / LiNKbot-core handoff (optional). Default POST body = gateway `agent` params
# (message, idempotencyKey, linktrendGovernance, optional sessionKey). See README.
OPENCLAW_AGENT_RUN_URL=
OPENCLAW_RUN_AUTH_BEARER=
OPENCLAW_AGENT_RUN_BODY=agent_params
OPENCLAW_AGENT_INGRESS_MESSAGE=
OPENCLAW_AGENT_SESSION_KEY=
OPENCLAW_AGENT_ID=
BOT_RUNTIME_MISSION_ID=
BOT_RUNTIME_SKILL_NAME=bootstrap

MVO_E2E_BASE_URL=

MVO_E2E_TENANT_ID=
