{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linkautowork/template.schema.json",
  "title": "LiNKautowork Workflow Template",
  "type": "object",
  "required": [
    "version",
    "templateVersion",
    "handle",
    "displayName",
    "description",
    "requiresLease",
    "source",
    "tags",
    "createdAt",
    "updatedAt",
    "author",
    "environments"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "templateVersion": {
      "type": "string",
      "minLength": 1
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requiresLease": {
      "type": "boolean"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "handlerCode"],
          "properties": {
            "type": { "const": "inline" },
            "handlerCode": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "n8nWorkflowId"],
          "properties": {
            "type": { "const": "n8n" },
            "n8nWorkflowId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "filePath"],
          "properties": {
            "type": { "const": "file" },
            "filePath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["development", "staging", "production"]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
