{
  "name": "@linktrend/linkskills-logic-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "linkskills-logic-engine": "./dist/bin/serve.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin/serve.js",
